{
  "name": "runreplay",
  "version": "0.2.0",
  "description": "Inspect GitHub Actions jobs and capture the facts needed for reliable replay.",
  "type": "module",
  "bin": {
    "runreplay": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/cli.test.js dist/format.test.js dist/json.test.js dist/resolve.test.js dist/url.test.js",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  },
  "license": "Apache-2.0",
  "keywords": [
    "github-actions",
    "ci",
    "debugging",
    "cli",
    "replay"
  ],
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
